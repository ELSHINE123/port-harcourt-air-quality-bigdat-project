# AWS RDS PostgreSQL Database Configuration
# Copy this file to '.env' and fill in your actual AWS RDS connection details.
# DO NOT commit '.env' to version control!

DB_HOST=your-rds-endpoint.cxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=niger_delta_audit
DB_USER=postgres
DB_PASSWORD=your_secure_rds_password

# Streaming Configuration
STREAM_BATCH_SIZE=30000
STREAM_INTERVAL_SECONDS=3
